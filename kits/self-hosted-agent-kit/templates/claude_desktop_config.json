{
  "mcpServers": {
    "zerolabs-postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://agent:your_secret_here@127.0.0.1:5432/agentdb"
      ]
