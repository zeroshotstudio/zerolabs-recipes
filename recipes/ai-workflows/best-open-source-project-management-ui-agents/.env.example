# Provider selection: "plane", "openproject", "vikunja", or "mock"
PM_PROVIDER=mock

# Plane Configuration
PLANE_BASE_URL=https://plane.example.com
PLANE_API_TOKEN=your-plane-api-token
PLANE_WORKSPACE_SLUG=default-workspace
PLANE_PROJECT_ID=project-uuid-here

# OpenProject Configuration
OPENPROJECT_BASE_URL=https://openproject.example.com
OPENPROJECT_API_KEY=your-openproject-api-key
OPENPROJECT_PROJECT_ID=project-id-here

# Vikunja Configuration
VIKUNJA_BASE_URL=https://vikunja.example.com
VIKUNJA_API_TOKEN=your-vikunja-api-token
VIKUNJA_PROJECT_ID=list-or-project-id-here
