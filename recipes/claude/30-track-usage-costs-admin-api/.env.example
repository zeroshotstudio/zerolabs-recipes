# Anthropic Admin & Standard API Keys
# Admin API key requires Organization Admin privileges to query /v1/organizations endpoints
ANTHROPIC_ADMIN_API_KEY=your_admin_api_key_here
ANTHROPIC_API_KEY=your_standard_api_key_here

# Organization and Workspace Configuration
ANTHROPIC_ORGANIZATION_ID=org_01xxxxxxxxxxxxxxxxxxxx
ANTHROPIC_WORKSPACE_ID=wrk_01xxxxxxxxxxxxxxxxxxxx

# Exporter Configuration
PROMETHEUS_PORT=9108
POLL_INTERVAL_SECONDS=60
